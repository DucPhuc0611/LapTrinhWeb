@model IEnumerable<WebBanHang.Models.CartItem>

<h2 class="mt-4 mb-4">🛒 Giỏ hàng của bạn</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Giỏ hàng đang trống. <a asp-controller="Product" asp-action="Index">Quay lại mua sắm ngay!</a></div>
}
else
{
    <table class="table table-bordered">
        <thead class="thead-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="@item.Product.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;" /></td>
                    <td style="vertical-align: middle;">@item.Product.Name</td>
                    <td style="vertical-align: middle; color: red;">@item.Product.Price.ToString("#,##0") VNĐ</td>
                    <td style="vertical-align: middle;">@item.Quantity</td>
                    <td style="vertical-align: middle; font-weight: bold; color: red;">@((item.Product.Price * item.Quantity).ToString("#,##0")) VNĐ</td>
                    <td style="vertical-align: middle;">
                        <a asp-action="RemoveFromCart" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-danger">❌ Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-right">
        <h4 style="color: red; font-weight: bold;">Tổng tiền thanh toán: @Model.Sum(i => i.Product.Price * i.Quantity).ToString("#,##0") VNĐ</h4>
        <div class="mt-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-secondary mr-2">Tiếp tục mua sắm</a>
            <button class="btn btn-success" onclick="alert('Tính năng thanh toán đang được phát triển!')">💳 Thanh toán ngay</button>
        </div>
    </div>
}