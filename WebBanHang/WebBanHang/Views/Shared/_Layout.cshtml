<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoCongNghe.Vn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .cps-header {
            background-color: #d70018;
            color: white;
        }

            .cps-header a {
                color: white;
                text-decoration: none;
            }

                .cps-header a:hover {
                    color: #f3f4f6;
                }

        .search-input {
            border-radius: 8px 0 0 8px;
            border: none;
        }

        .search-btn {
            border-radius: 0 8px 8px 0;
            background-color: white;
            color: #333;
            border: none;
        }
    </style>
</head>
<body style="background-color: #f4f6f8;">
    <header class="cps-header py-2 shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="/Product" class="fs-4 fw-bold">
                <i class="fa-solid fa-mobile-screen"></i> DoCongNghe.Vn
            </a>

            <div class="input-group w-40" style="max-width: 400px;">
                <input type="text" class="form-control search-input" placeholder="Bạn cần tìm gì?">
                <button class="btn search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>

            <div class="d-flex align-items-center gap-4 fw-semibold" style="font-size: 14px;">
                <a href="#" class="text-center"><i class="fa-solid fa-phone fs-5"></i><br>Gọi mua hàng</a>
                <a href="/Cart" class="text-center"><i class="fa-solid fa-bag-shopping fs-5"></i><br>Giỏ hàng</a>

                @{
                    var username = Context.Session.GetString("Username");
                }

                @if (!string.IsNullOrEmpty(username))
                {
                    <a href="#" class="text-center text-success"><i class="fa-regular fa-circle-user fs-5"></i><br>Chào @username</a>
                    <a href="/User/Logout" class="text-center"><i class="fa-solid fa-right-from-bracket fs-5"></i><br>Đăng xuất</a>
                }
                else
                {
                    <a href="/User/Login" class="text-center"><i class="fa-regular fa-circle-user fs-5"></i><br>Đăng nhập</a>
                }

                <a href="/Product" class="text-center text-warning"><i class="fa-solid fa-gear fs-5"></i><br>Quản trị</a>
            </div>
        </div>
    </header>

    <nav class="bg-white border-bottom shadow-sm mb-4">
        <div class="container d-flex gap-4 py-2 fw-bold" style="font-size: 15px;">
            <a href="#" class="text-dark text-decoration-none"><i class="fa-solid fa-mobile-button text-secondary"></i> Điện thoại</a>
            <a href="#" class="text-dark text-decoration-none"><i class="fa-solid fa-laptop text-secondary"></i> Laptop</a>
            <a href="#" class="text-dark text-decoration-none"><i class="fa-solid fa-headphones text-secondary"></i> Âm thanh</a>
            <a href="#" class="text-dark text-decoration-none"><i class="fa-solid fa-stopwatch text-secondary"></i> Đồng hồ</a>
        </div>
    </nav>

    <div class="container" style="min-height: 65vh;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2026 - Dự án MVC Clone CellphoneS</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>