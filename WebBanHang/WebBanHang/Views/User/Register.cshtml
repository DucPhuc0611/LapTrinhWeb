@model WebBanHang.Models.User
@{
    ViewData["Title"] = "Đăng ký";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0" style="border-radius: 15px;">
            <div class="card-body p-4">
                <h3 class="text-center fw-bold mb-4" style="color: #d70018;">Tạo Tài Khoản</h3>

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A...">
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tài khoản (SĐT hoặc Email)</label>
                        <input asp-for="Username" class="form-control" placeholder="09xxxx...">
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu...">
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn text-white w-100 fw-bold py-2" style="background-color: #d70018; border-radius: 8px;">ĐĂNG KÝ</button>
                </form>

                <div class="text-center mt-3">
                    <p>Đã có tài khoản? <a href="/User/Login" class="text-primary text-decoration-none">Đăng nhập</a></p>
                </div>
            </div>
        </div>
    </div>
</div>