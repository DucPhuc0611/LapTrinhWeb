@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0" style="border-radius: 15px;">
            <div class="card-body p-4">
                <h3 class="text-center fw-bold mb-4" style="color: #d70018;">Đăng Nhập</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger fw-bold text-center">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tài khoản (SĐT hoặc Email)</label>
                        <input type="text" name="username" class="form-control" placeholder="Nhập tài khoản..." required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu..." required>
                    </div>
                    <button type="submit" class="btn text-white w-100 fw-bold py-2" style="background-color: #d70018; border-radius: 8px;">ĐĂNG NHẬP</button>
                </form>

                <div class="text-center mt-3">
                    <p>Chưa có tài khoản? <a href="/User/Register" class="text-primary text-decoration-none">Đăng ký ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>